{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "importMap": "./import_map.json",
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "exclude": [
      "CHANGELOG.md"
    ]
  },
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test --allow-env --allow-read",
    "check": "deno check manifest.ts workflows/example_workflow.ts",
    "dev": "slack run workflows/example_workflow",
    "check-openai-key": "deno run --allow-env --allow-net --allow-read scripts/check_openai_key.ts",
    "cursor-ci": "deno fmt --check && deno lint && deno check manifest.ts workflows/example_workflow.ts && deno test --allow-env --allow-read"
  }
}
